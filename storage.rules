rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /dish-images/{dishId}/{fileName} {
      allow read: if true;
      // Replace OWNER_EMAIL_REQUIRED with the confirmed restaurant-owner Google account
      // before deploying Storage rules. This intentionally fails closed meanwhile.
      allow write: if request.auth != null
                   && request.auth.token.email == 'OWNER_EMAIL_REQUIRED'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
