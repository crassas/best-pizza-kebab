{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "best-pizza-kebab",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  },
  "observability": {
    "enabled": true
  }
}
